# nixfmt, treefmt and the pre-commit hook own this tree; the settings here are
# for an editor opened on a checkout without the devshell.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 4

[*.fish]
indent_style = space
indent_size = 4

[justfile]
indent_style = space
indent_size = 4

[*.md]
# A hard break in Markdown is two trailing spaces.
trim_trailing_whitespace = false
